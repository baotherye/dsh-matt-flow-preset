{
  "name": "@baotherye/dsh-matt-flow-preset",
  "version": "0.8.2",
  "description": "把 Matt Pocock 技能套件编成六阶段带前置条件的开发工作流预设：拷问、规范、任务、实现、评审、收尾。技能仅对 Matt 预设可见。含输入框工具行的阶段胶囊与决策卡片。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "screenshots.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baotherye/dsh-matt-flow-preset.git"
  },
  "homepage": "https://github.com/baotherye/dsh-matt-flow-preset#readme",
  "bugs": {
    "url": "https://github.com/baotherye/dsh-matt-flow-preset/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "workflow",
    "matt-pocock",
    "skills"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
